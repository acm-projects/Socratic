generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model achievements {
  id                String              @id @db.VarChar(50)
  name              String              @db.VarChar(100)
  description       String?
  xp_reward         Int?                @default(0)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  slug              String?
  icon_colored      String?
  icon_greyed       String?
  user_achievements user_achievements[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model chat_history {
  id            String        @id @db.VarChar(50)
  session_id    String        @db.VarChar(50)
  sender        String        @db.VarChar(10)
  content       String
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  score         Int?          @default(0)
  reason        String?
  chat_sessions chat_sessions @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_history_sessions")
}

model chat_sessions {
  session_id   String         @id @db.VarChar(50)
  class_code   String         @db.VarChar(50)
  user_id      String         @db.VarChar(50)
  topic_id     String         @db.VarChar(50)
  started_at   DateTime?      @default(now()) @db.Timestamp(6)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  title        String?        @db.VarChar(100)
  chat_history chat_history[]
  classes      classes        @relation(fields: [class_code], references: [class_code], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_sessions_class")
  topics       topics         @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_sessions_topic")
  users        User           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_sessions_user")
}

model classes {
  class_code          String                @id @db.VarChar(50)
  subject             String                @db.VarChar(100)
  name                String                @db.VarChar(30)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  user_id             String?
  syllabus_url        String?
  streak              Int?                  @default(0)
  last_activity_date  DateTime?             @db.Date
  chat_sessions       chat_sessions[]
  class_tasks         class_tasks[]
  course_materials    course_materials[]
  daily_topic_metrics daily_topic_metrics[]
  syllabus_info       syllabus_info?
  topics              topics[]
  user_classes        user_classes[]
}

model daily_topic_metrics {
  user_id         String   @db.VarChar(50)
  class_code      String   @db.VarChar(50)
  topic_id        String?  @db.VarChar(50)
  metric_date     DateTime @db.Date
  avg_score       Decimal? @db.Decimal(5, 2)
  questions_asked Int?     @default(0)
  classes         classes  @relation(fields: [class_code], references: [class_code], onDelete: Cascade, onUpdate: NoAction, map: "fk_daily_metrics_class")
  topics          topics?  @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_daily_metrics_topic")
  users           User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_daily_metrics_user")

  @@unique([user_id, class_code, metric_date], map: "uq_daily_topic_metrics")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model friend_requests {
  id                                       String    @id @db.VarChar(50)
  sender_id                                String    @db.VarChar(50)
  receiver_id                              String    @db.VarChar(50)
  status                                   String    @db.VarChar(20)
  created_at                               DateTime? @default(now()) @db.Timestamp(6)
  responded_at                             DateTime? @db.Timestamp(6)
  users_friend_requests_receiver_idTousers User      @relation("friend_requests_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friend_requests_receiver")
  users_friend_requests_sender_idTousers   User      @relation("friend_requests_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friend_requests_sender")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model friends {
  user_id                        String    @db.VarChar(50)
  friend_id                      String    @db.VarChar(50)
  created_at                     DateTime? @default(now()) @db.Timestamp(6)
  streak                         Int?
  total_xp                       Int?
  first_name                     String?
  last_name                      String?
  users_friends_friend_idTousers User      @relation("friends_friend_idTousers", fields: [friend_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friends_friend")
  users_friends_user_idTousers   User      @relation("friends_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_friends_user")

  @@id([user_id, friend_id])
}

model topics {
  id                  String                @id @db.VarChar(50)
  class_code          String                @db.VarChar(50)
  name                String                @db.VarChar(50)
  chat_sessions       chat_sessions[]
  daily_topic_metrics daily_topic_metrics[]
  classes             classes               @relation(fields: [class_code], references: [class_code], onDelete: Cascade, onUpdate: NoAction, map: "fk_topics_class")
}

model user_achievements {
  user_id        String       @db.VarChar(50)
  achievement_id String       @db.VarChar(50)
  earned_at      DateTime?    @default(now()) @db.Timestamp(6)
  achievements   achievements @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_achievements_achievement")
  users          User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_achievements_user")

  @@id([user_id, achievement_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model xp_system {
  id         String    @id @db.VarChar(50)
  user_id    String    @db.VarChar(50)
  source     String    @db.VarChar(20)
  amount     Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_xp_system_user")
}

model User {
  id                                                 String                @id(map: "users_pkey") @default(cuid()) @db.VarChar(50)
  email                                              String                @unique(map: "users_email_key") @db.VarChar(225)
  total_xp                                           Int?                  @default(0)
  image                                              String?
  emailVerified                                      DateTime?             @db.Timestamp(6)
  createdAt                                          DateTime?             @default(now()) @db.Timestamp(6)
  updatedAt                                          DateTime?             @default(now()) @db.Timestamp(6)
  name                                               String?
  first_name                                         String?
  last_name                                          String?
  school                                             String?
  major                                              String?
  class_status                                       String?
  streak                                             Int?
  weekly_xp                                          Int?                  @default(0)
  ai_messages                                        Int                   @default(0)
  quizzes_taken                                      Int                   @default(0)
  retakes_taken                                      Int                   @default(0)
  last_active_date                                   DateTime?             @db.Date
  Account                                            Account[]
  chat_sessions                                      chat_sessions[]
  class_engagement                                   class_engagement[]
  daily_topic_metrics                                daily_topic_metrics[]
  friend_requests_friend_requests_receiver_idTousers friend_requests[]     @relation("friend_requests_receiver_idTousers")
  friend_requests_friend_requests_sender_idTousers   friend_requests[]     @relation("friend_requests_sender_idTousers")
  friends_friends_friend_idTousers                   friends[]             @relation("friends_friend_idTousers")
  friends_friends_user_idTousers                     friends[]             @relation("friends_user_idTousers")
  user_achievements                                  user_achievements[]
  user_classes                                       user_classes[]
  xp_system                                          xp_system[]
}

model Account {
  userId                   String    @db.VarChar(50)
  provider                 String    @db.VarChar(50)
  providerAccountId        String    @db.VarChar(100)
  access_token             String?
  refresh_token            String?
  expires_at               BigInt?
  type                     String?   @db.VarChar(50)
  token_type               String?   @db.VarChar(50)
  scope                    String?
  id_token                 String?
  session_state            String?
  createdAt                DateTime? @default(now()) @db.Timestamp(6)
  updatedAt                DateTime? @default(now()) @db.Timestamp(6)
  refresh_token_expires_in Int?
  updatedat                DateTime? @default(now()) @db.Timestamp(6)
  is_approved              Boolean?  @default(false)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model chats {
  id                String     @id
  title             String?
  created_at        DateTime?  @default(now()) @db.Timestamptz(6)
  accumulated_score Int?       @default(0)
  messages          messages[]
}

model langchain_chat_messages {
  id         Int    @id @default(autoincrement())
  session_id String @db.VarChar(255)
  message    Json
}

model messages {
  id         Int       @id @default(autoincrement())
  chat_id    String?
  role       String?
  content    String?
  score      Int?      @default(0)
  reason     String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  chats      chats?    @relation(fields: [chat_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model quiz_questions {
  id             String   @id
  quiz_id        String
  question       String
  user_answer    String?
  correct_answer String
  is_correct     Boolean? @default(false)
  depth_score    Int?     @default(0)
  options        String[]
  explanation    String?
  quizzes        quizzes  @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model quizzes {
  id             String           @id
  user_id        String
  topic_id       String
  score          Int?             @default(0)
  date           DateTime?        @default(now()) @db.Timestamp(6)
  retake_count   Int?             @default(0)
  color          String?
  quiz_questions quiz_questions[]
}

model class_engagement {
  id             String   @id
  user_id        String
  class_name     String
  question_count Int?     @default(0)
  week_start     DateTime @db.Timestamp(6)
  color          String?
  light          String?
  User           User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, class_name, week_start])
}

model class_tasks {
  id         String    @id @db.Uuid
  class_code String    @db.VarChar(50)
  task_name  String    @db.VarChar(255)
  due_date   DateTime  @db.Date
  created_at DateTime? @default(now()) @db.Timestamp(6)
  completed  Boolean   @default(false)
  classes    classes   @relation(fields: [class_code], references: [class_code], onDelete: Cascade, onUpdate: NoAction)

  @@index([class_code], map: "idx_class_tasks_code")
}

model course_materials {
  id          String    @id
  class_code  String
  user_id     String
  file_name   String
  file_url    String?
  doc_type    String?   @default("document")
  uploaded_at DateTime? @default(now()) @db.Timestamp(6)
  classes     classes   @relation(fields: [class_code], references: [class_code], onDelete: Cascade, onUpdate: NoAction)
}

model shared_classes {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id    String
  friend_id  String
  class_code String
  class_name String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([user_id, friend_id, class_code], map: "unique_shared_class")
}

model user_classes {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String
  class_code  String
  enrolled_at DateTime? @default(now()) @db.Timestamp(6)
  classes     classes   @relation(fields: [class_code], references: [class_code], onDelete: Cascade, onUpdate: NoAction)
  User        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, class_code])
}

model syllabus_info {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_code      String    @unique @db.VarChar(50)
  professor_name  String?
  professor_email String?
  office_hours    String?
  office_location String?
  ta_name         String?
  ta_email        String?
  ta_office_hours String?
  grading_policy  Json?
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
  classes         classes   @relation(fields: [class_code], references: [class_code], onDelete: Cascade, onUpdate: NoAction)
}
