{
  "openapi": "3.0.0",
  "info": {
    "title": "Socratic API",
    "version": "1.0.0",
    "description": "API for the Socratic platform — handles users, classes, topics, chat sessions, achievements, friends, OAuth accounts, and Google Calendar integration."
  },
  "servers": [
    {
      "url": "http://3.128.186.118:5000",
      "description": "Production EC2 server"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Health Check",
        "description": "Check if the API is running",
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Ok combined api is working 🚀" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/create-tokens": {
      "post": {
        "summary": "Exchange Google Auth Code for Tokens",
        "description": "Sends a Google OAuth authorization code and receives access/refresh tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": { "type": "string", "example": "4/0AX4XfWh..." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" },
                    "refresh_token": { "type": "string" },
                    "expiry_date": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/create-event": {
      "post": {
        "summary": "Create a Google Calendar Event",
        "description": "Creates a new event on the user's primary Google Calendar, optionally with a Google Meet link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["summary", "startDateTime", "endDateTime"],
                "properties": {
                  "summary": { "type": "string", "example": "Study Session" },
                  "description": { "type": "string", "example": "Review chapter 5" },
                  "location": { "type": "string", "example": "Library Room 2" },
                  "startDateTime": { "type": "string", "format": "date-time", "example": "2026-03-21T10:00:00" },
                  "endDateTime": { "type": "string", "format": "date-time", "example": "2026-03-21T11:00:00" },
                  "createMeet": { "type": "boolean", "example": true },
                  "attendeeEmails": {
                    "type": "array",
                    "items": { "type": "string", "format": "email" },
                    "example": ["student@example.com"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "summary": { "type": "string" },
                    "htmlLink": { "type": "string" },
                    "hangoutLink": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/extract": {
      "post": {
        "summary": "Extract Syllabus Data",
        "description": "Upload a syllabus PDF and extract course data using Gemini AI",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "syllabusPdf": {
                    "type": "string",
                    "format": "binary",
                    "description": "The syllabus PDF file to upload"
                  },
                  "pdfText": {
                    "type": "string",
                    "description": "Raw text fallback if no PDF is provided"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Syllabus extracted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/SyllabusData" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/save": {
      "post": {
        "summary": "Save Syllabus Data",
        "description": "Save extracted syllabus data (class and topics) to the database",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SyllabusData" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Syllabus data saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "savedClass": { "$ref": "#/components/schemas/Class" },
                        "savedTopics": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Topic" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Missing required fields" },
          "409": { "description": "Class or topic already exists" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/upload": {
      "post": {
        "summary": "Upload Syllabus PDF to S3",
        "description": "Upload a syllabus PDF to S3 and save the URL to the classes table",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["syllabusPdf", "class_code"],
                "properties": {
                  "syllabusPdf": {
                    "type": "string",
                    "format": "binary",
                    "description": "The syllabus PDF file to upload"
                  },
                  "class_code": {
                    "type": "string",
                    "example": "CS101",
                    "description": "The class code to link the syllabus to"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Syllabus uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "syllabus_url": { "type": "string", "example": "https://socratic-syllabi.s3.us-east-2.amazonaws.com/syllabi/uuid-filename.pdf" }
                  }
                }
              }
            }
          },
          "400": { "description": "Missing file or class_code" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/syllabus/{class_code}": {
      "get": {
        "summary": "Get Syllabus URL for a Class",
        "description": "Returns the S3 URL of the syllabus PDF for a specific class",
        "parameters": [
          {
            "name": "class_code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "CS101"
          }
        ],
        "responses": {
          "200": {
            "description": "Syllabus URL returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "syllabus_url": { "type": "string", "example": "https://socratic-syllabi.s3.us-east-2.amazonaws.com/syllabi/uuid-filename.pdf" }
                  }
                }
              }
            }
          },
          "404": { "description": "No syllabus found for this class" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Get All Users",
        "description": "Returns a list of all users",
        "responses": {
          "200": {
            "description": "A list of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      },
      "post": {
        "summary": "Create a User",
        "description": "Creates a new user in the database",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/User" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Get User by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A single user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      },
      "put": {
        "summary": "Update a User",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "total_xp": { "type": "integer" },
                  "weekly_xp": { "type": "integer" },
                  "image": { "type": "string" },
                  "first_name": { "type": "string" },
                  "last_name": { "type": "string" },
                  "school": { "type": "string" },
                  "major": { "type": "string" },
                  "class_status": { "type": "string", "enum": ["Freshman", "Sophomore", "Junior", "Senior"] },
                  "streak": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      },
      "delete": {
        "summary": "Delete a User",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "User deleted" }
                  }
                }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/classes": {
      "get": {
        "summary": "Get All Classes",
        "description": "Returns all classes. Pass optional ?user_id= to filter by user.",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter classes by user ID",
            "example": "user_123"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of classes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Class" }
                }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      },
      "post": {
        "summary": "Create a Class",
        "description": "Creates a new class linked to a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Class" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Class created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Class" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/classes/{code}": {
      "get": {
        "summary": "Get Class by Code",
        "description": "Returns a single class by its class code",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "CS101"
          }
