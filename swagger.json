        "description": "Links a new OAuth provider account to a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Account" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account linked successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Account" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/accounts/{provider}/{providerAccountId}": {
      "get": {
        "summary": "Get Account by Provider",
        "description": "Returns a specific OAuth account by provider and provider account ID",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "google"
          },
          {
            "name": "providerAccountId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "1234567890"
          }
        ],
        "responses": {
          "200": {
            "description": "A single OAuth account",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Account" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      },
      "put": {
        "summary": "Update OAuth Account Tokens",
        "description": "Updates the access and refresh tokens for an OAuth account",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "google"
          },
          {
            "name": "providerAccountId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "1234567890"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "access_token": { "type": "string" },
                  "refresh_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account tokens updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Account" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      },
      "delete": {
        "summary": "Unlink OAuth Account",
        "description": "Removes a linked OAuth account",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "google"
          },
          {
            "name": "providerAccountId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "1234567890"
          }
        ],
        "responses": {
          "200": {
            "description": "Account unlinked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Account unlinked" }
                  }
                }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/users/{id}/friends": {
      "get": {
        "summary": "Get Friends by User",
        "description": "Returns all friends for a specific user",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of friends",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Friend" }
                }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/friends": {
      "post": {
        "summary": "Add a Friend",
        "description": "Adds a new friend to a user's friends list",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Friend" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Friend added successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Friend" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/users/{id}/friend-requests": {
      "get": {
        "summary": "Get Friend Requests by User Email",
        "description": "Returns all incoming friend requests for a specific user by email",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The user's email address"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of friend requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/FriendRequest" }
                }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/friend-requests": {
      "post": {
        "summary": "Send a Friend Request",
        "description": "Creates a new friend request using sender and receiver emails",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FriendRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Friend request sent successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FriendRequest" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/friend-requests/{id}": {
      "put": {
        "summary": "Update Friend Request Status",
        "description": "Accepts or rejects a friend request",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "example": "accepted", "enum": ["pending", "accepted", "rejected"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Friend request updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FriendRequest" }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "user_123" },
          "email": { "type": "string", "format": "email", "example": "student@example.com" },
          "first_name": { "type": "string", "example": "John" },
          "last_name": { "type": "string", "example": "Doe" },
          "school": { "type": "string", "example": "University of Texas at Dallas" },
          "major": { "type": "string", "example": "Computer Science" },
          "class_status": { "type": "string", "enum": ["Freshman", "Sophomore", "Junior", "Senior"], "example": "Freshman" },
          "streak": { "type": "integer", "example": 7 },
          "total_xp": { "type": "integer", "example": 500 },
          "weekly_xp": { "type": "integer", "example": 120 },
          "image": { "type": "string", "example": "https://example.com/avatar.png" }
        }
      },
      "Class": {
        "type": "object",
        "properties": {
          "class_code": { "type": "string", "example": "CS101" },
          "subject": { "type": "string", "example": "Computer Science" },
          "name": { "type": "string", "example": "Introduction to Programming" },
          "user_id": { "type": "string", "example": "user_123" },
          "syllabus_url": { "type": "string", "example": "https://socratic-syllabi.s3.us-east-2.amazonaws.com/syllabi/uuid-filename.pdf" }
        }
      },
      "Topic": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "topic_456" },
          "class_code": { "type": "string", "example": "CS101" },
          "name": { "type": "string", "example": "Variables and Data Types" }
        }
      },
      "ChatSession": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string", "example": "sess_789" },
          "class_code": { "type": "string", "example": "CS101" },
          "user_id": { "type": "string", "example": "user_123" },
          "topic_id": { "type": "string", "example": "topic_456" }
        }
      },
      "Achievement": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "ach_001" },
          "name": { "type": "string", "example": "First Session" },
          "description": { "type": "string", "example": "Completed your first chat session" }
        }
      },
      "UserStats": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string", "example": "user_123" },
          "total_xp": { "type": "integer", "example": 500 },
          "weekly_xp": { "type": "integer", "example": 120 }
        }
      },
      "TopicMetrics": {
        "type": "object",
        "properties": {
          "topic_id": { "type": "string", "example": "topic_456" },
          "date": { "type": "string", "format": "date", "example": "2026-03-21" },
          "session_count": { "type": "integer", "example": 10 }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "userId": { "type": "string", "example": "user_123" },
          "provider": { "type": "string", "example": "google" },
          "providerAccountId": { "type": "string", "example": "1234567890" },
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "type": { "type": "string", "example": "oauth" }
        }
      },
      "Friend": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string", "example": "user_123" },
          "friend_id": { "type": "string", "example": "user_456" },
          "first_name": { "type": "string", "example": "Jane" },
          "last_name": { "type": "string", "example": "Smith" },
          "streak": { "type": "integer", "example": 5 },
          "total_xp": { "type": "integer", "example": 300 }
        }
      },
      "FriendRequest": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "req_001" },
          "sender_email": { "type": "string", "format": "email", "example": "sender@example.com" },
          "receiver_email": { "type": "string", "format": "email", "example": "receiver@example.com" },
          "status": { "type": "string", "example": "pending", "enum": ["pending", "accepted", "rejected"] }
        }
      },
      "SyllabusData": {
        "type": "object",
        "properties": {
          "courseName": { "type": "string", "example": "Introduction to Programming" },
          "courseCode": { "type": "string", "example": "CS101" },
          "instructor": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "example": "Dr. Smith" },
              "email": { "type": "string", "example": "smith@university.edu" },
              "officeHours": { "type": "string", "example": "MWF 2-3pm" }
            }
          },
          "gradingPolicy": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": { "type": "string", "example": "Homework" },
                "weightPercentage": { "type": "integer", "example": 20 }
              }
            }
          },
          "importantDates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "eventName": { "type": "string", "example": "Midterm" },
                "date": { "type": "string", "example": "2026-03-15" }
              }
            }
          },
          "topics": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["Variables", "Loops", "Functions"]
          }
        }
      }
    }
  }
}