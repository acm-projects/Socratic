          {
            "name": "providerAccountId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "1234567890"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "access_token": { "type": "string" },
                  "refresh_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account tokens updated successfully",
