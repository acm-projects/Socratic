{
  "openapi": "3.0.0",
  "info": {
    "title": "Socratic API",
    "version": "1.0.0",
    "description": "API for the Socratic platform — handles users, classes, topics, chat sessions, achievements, friends, OAuth accounts, and Google Calendar integration."
  },
  "servers": [
    { "url": "http://3.128.186.118:5000", "description": "Production EC2 server" },
    { "url": "http://localhost:5000", "description": "Local development server" }
  ],
  "paths": {
    "/": { "get": { "summary": "Health Check", "responses": { "200": { "description": "API is running" } } } },
    "/api/calendar/create-tokens": {
      "post": {
        "summary": "Exchange Google Auth Code for Tokens",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Tokens successfully created" } }
      }
    },
    "/api/calendar/create-event": {
      "post": {
        "summary": "Create a Google Calendar Event",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["summary", "startDateTime", "endDateTime"], "properties": { "summary": { "type": "string" }, "description": { "type": "string" }, "location": { "type": "string" }, "startDateTime": { "type": "string", "format": "date-time" }, "endDateTime": { "type": "string", "format": "date-time" }, "createMeet": { "type": "boolean" }, "attendeeEmails": { "type": "array", "items": { "type": "string", "format": "email" } } } } } } },
        "responses": { "200": { "description": "Event created successfully" } }
      }
    },
    "/api/calendar/upcoming-events": { "get": { "summary": "Get Upcoming Events", "responses": { "200": { "description": "A list of upcoming calendar events" }, "500": { "description": "Server error" } } } },
    "/api/calendar/events": {
      "get": {
        "summary": "Get All Events",
        "parameters": [
          { "name": "timeMin", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
          { "name": "timeMax", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
          { "name": "maxResults", "in": "query", "required": false, "schema": { "type": "integer", "default": 100 } }
        ],
        "responses": { "200": { "description": "A list of calendar events" }, "500": { "description": "Server error" } }
      }
    },
    "/api/ingest/upload": {
      "post": {
        "summary": "Upload Document to S3 and Pinecone",
        "description": "Upload PDF(s) to S3, chunk them using LangChain, and index into the shared Pinecone class namespace.",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file", "classCode"], "properties": { "file": { "type": "string", "format": "binary" }, "classCode": { "type": "string", "example": "CS 3345" }, "docType": { "type": "string", "enum": ["syllabus", "textbook", "slides", "notes", "document"], "default": "document" } } } } } },
        "responses": { "200": { "description": "Documents successfully ingested" } }
      }
    },
    "/api/ingest/status/{classCode}": {
      "get": {
        "summary": "Get Pinecone Vector Count",
        "parameters": [{ "name": "classCode", "in": "path", "required": true, "schema": { "type": "string" }, "example": "CS 1436" }],
        "responses": { "200": { "description": "Status returned successfully" } }
      }
    },
    "/api/quizzes/generate": {
      "post": {
        "summary": "Generate AI Quiz",
        "description": "Generates a dynamic 4-option multiple-choice quiz using Gemini AI over the class Pinecone Vector Knowledge Base.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["classCode", "topic", "numQuestions"], "properties": { "classCode": { "type": "string", "example": "CS 1436" }, "topic": { "type": "string", "example": "Binary Search Trees" }, "numQuestions": { "type": "integer", "example": 5, "default": 5 } } } } } },
        "responses": { "200": { "description": "Generated Quiz successfully" } }
      }
    },
    "/api/tutor/chat": {
      "post": {
        "summary": "Chat with Socratic AI Tutor",
        "description": "Send a message to the Socratic AI Tutor. It uses memory (Postgres) and RAG (Pinecone) to guide the student.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["userId", "classCode", "topic", "message"], "properties": { "userId": { "type": "string", "example": "aakash" }, "classCode": { "type": "string", "example": "CS 1000" }, "topic": { "type": "string", "example": "Introduction to Algebra" }, "message": { "type": "string", "example": "what is my name" } } } } } },
        "responses": { "200": { "description": "Tutor response generated successfully" } }
      }
    },
    "/extract": {
      "post": {
        "summary": "Extract Syllabus Data",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "syllabusPdf": { "type": "string", "format": "binary" }, "pdfText": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Syllabus extracted successfully" }, "400": { "description": "Validation error" }, "500": { "description": "Server error" } }
      }
    },
    "/save": {
      "post": {
        "summary": "Save Syllabus Data",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyllabusData" } } } },
        "responses": { "200": { "description": "Saved successfully" }, "400": { "description": "Missing fields" }, "409": { "description": "Already exists" }, "500": { "description": "Server error" } }
      }
    },
    "/upload": {
      "post": {
        "summary": "Upload Syllabus PDF to S3",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["syllabusPdf", "class_code"], "properties": { "syllabusPdf": { "type": "string", "format": "binary" }, "class_code": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Uploaded successfully" }, "400": { "description": "Missing file or class_code" }, "500": { "description": "Server error" } }
      }
    },
    "/syllabus/{class_code}": {
      "get": {
        "summary": "Get Syllabus URL for a Class",
        "parameters": [{ "name": "class_code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Syllabus URL returned" }, "404": { "description": "Not found" }, "500": { "description": "Server error" } }
      }
    },
    "/users": {
      "get": { "summary": "Get All Users", "responses": { "200": { "description": "A list of users", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } } } } }, "500": { "description": "Server error" } } },
      "post": { "summary": "Create a User", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } }, "responses": { "200": { "description": "User created" }, "500": { "description": "Server error" } } }
    },
    "/users/{id}": {
      "get": {
        "summary": "Get User by ID",
        "description": "Returns a single user with friend_count and achievement_count included",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "A single user with counts",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserWithCounts" } } }
          },
          "500": { "description": "Server error" }
        }
      },
      "put": {
        "summary": "Update a User",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "email": { "type": "string" }, "total_xp": { "type": "integer" }, "weekly_xp": { "type": "integer" }, "image": { "type": "string" }, "first_name": { "type": "string" }, "last_name": { "type": "string" }, "school": { "type": "string" }, "major": { "type": "string" }, "class_status": { "type": "string", "enum": ["Freshman", "Sophomore", "Junior", "Senior"] }, "streak": { "type": "integer" } } } } } },
        "responses": { "200": { "description": "User updated" }, "500": { "description": "Server error" } }
      },
      "delete": { "summary": "Delete a User", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "User deleted" }, "500": { "description": "Server error" } } }
    },
    "/users/{id}/xp-history": {
      "get": {
        "summary": "Get XP Earned Over Time",
        "description": "Returns daily or monthly XP. Use ?group_by=month for monthly totals, ?group_by=day (default) for daily with zero-filling.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "days", "in": "query", "required": false, "schema": { "type": "integer", "default": 30 }, "description": "Number of days to look back (only used for daily view)" },
          { "name": "group_by", "in": "query", "required": false, "schema": { "type": "string", "enum": ["day", "month"], "default": "day" }, "description": "Group results by day or month" }
        ],
        "responses": {
          "200": {
            "description": "Array of XP data",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "type": "array", "items": { "$ref": "#/components/schemas/XPHistory" } },
                    { "type": "array", "items": { "$ref": "#/components/schemas/XPHistoryMonthly" } }
                  ]
                }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      }
    },
    "/users/{id}/metrics": {
      "get": {
        "summary": "Get Overall Heatmap Metrics",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "days", "in": "query", "required": false, "schema": { "type": "integer", "default": 30 } }
        ],
        "responses": {
          "200": { "description": "Array of daily heatmap data", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/HeatmapMetric" } } } } },
          "500": { "description": "Server error" }
        }
      }
    },
    "/users/{id}/engagement/class-distribution": {
      "get": {
        "summary": "Get Class Distribution (Engagement Pie Chart)",
        "description": "Returns total question count per class with color and light fields",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Array of class engagement data with colors", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ClassDistribution" } } } } },
          "500": { "description": "Server error" }
        }
      }
    },
    "/users/{id}/achievements": {
      "get": {
        "summary": "Get Achievements by User",
        "description": "Returns all 20 achievements with unlocked status, unlocked_at, and user_name",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "A list of achievements with unlock status", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserAchievement" } } } } },
          "500": { "description": "Server error" }
        }
      }
    },
    "/users/{id}/stats": { "get": { "summary": "Get User Stats", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "User stats" }, "500": { "description": "Server error" } } } },
    "/users/{id}/sessions": { "get": { "summary": "Get Chat Sessions by User", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A list of chat sessions" }, "500": { "description": "Server error" } } } },
    "/users/{id}/accounts": { "get": { "summary": "Get OAuth Accounts by User", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A list of OAuth accounts" }, "500": { "description": "Server error" } } } },
    "/users/{id}/friends": { "get": { "summary": "Get Friends by User", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A list of friends" }, "500": { "description": "Server error" } } } },
    "/users/{id}/friend-requests": { "get": { "summary": "Get Friend Requests by User", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A list of friend requests" }, "500": { "description": "Server error" } } } },
    "/users/{id}/quizzes": { "get": { "summary": "Get Quizzes by User", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A list of quizzes with color", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Quiz" } } } } }, "500": { "description": "Server error" } } } },
    "/classes": {
      "get": { "summary": "Get All Classes", "description": "Pass ?user_id= to filter by user", "parameters": [{ "name": "user_id", "in": "query", "required": false, "schema": { "type": "string" } }], "responses": { "200": { "description": "A list of classes" }, "500": { "description": "Server error" } } },
      "post": { "summary": "Create a Class", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Class" } } } }, "responses": { "200": { "description": "Class created" }, "500": { "description": "Server error" } } }
    },
    "/classes/{code}": {
      "get": { "summary": "Get Class by Code", "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Class found" }, "404": { "description": "Not found" } } },
      "put": { "summary": "Update a Class", "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["subject", "name"], "properties": { "subject": { "type": "string" }, "name": { "type": "string" } } } } } }, "responses": { "200": { "description": "Updated" }, "404": { "description": "Not found" } } },
      "delete": { "summary": "Delete a Class", "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "user_id", "in": "query", "required": true, "schema": { "type": "string" }, "description": "Required to verify ownership" }], "responses": { "200": { "description": "Deleted" }, "404": { "description": "Not found" } } }
    },
    "/classes/{code}/topics": { "get": { "summary": "Get Topics by Class Code", "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A list of topics" }, "500": { "description": "Server error" } } } },
    "/classes/{code}/metrics": {
      "get": {
        "summary": "Get Per-Class Heatmap Metrics",
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string" }, "example": "CS101" },
          { "name": "user_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "days", "in": "query", "required": false, "schema": { "type": "integer", "default": 30 } }
        ],
        "responses": { "200": { "description": "Array of daily heatmap data", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/HeatmapMetric" } } } } }, "500": { "description": "Server error" } }
      }
    },
    "/topics": { "post": { "summary": "Create a Topic", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Topic" } } } }, "responses": { "200": { "description": "Topic created" }, "500": { "description": "Server error" } } } },
    "/topics/{id}": { "get": { "summary": "Get Topic by ID", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A single topic" }, "500": { "description": "Server error" } } } },
    "/topics/{id}/metrics": { "get": { "summary": "Get Topic Metrics", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Topic metrics" }, "500": { "description": "Server error" } } } },
    "/sessions": { "post": { "summary": "Create a Chat Session", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatSession" } } } }, "responses": { "200": { "description": "Session created" }, "500": { "description": "Server error" } } } },
    "/sessions/{id}": { "get": { "summary": "Get Session by ID", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A single chat session" }, "500": { "description": "Server error" } } } },
    "/api/history": { "get": { "summary": "Retrieve all chat sessions from PostgreSQL", "responses": { "200": { "description": "A list of chat sessions.", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object" } } } } } } } },
    "/api/history/{chatId}": { "get": { "summary": "Retrieve all messages for a specific chat ID", "parameters": [{ "name": "chatId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A list of messages.", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object" } } } } } } } },
    "/achievements": { "get": { "summary": "Get All Achievements", "description": "Returns the full list of 20 possible achievements", "responses": { "200": { "description": "A list of achievements", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Achievement" } } } } }, "500": { "description": "Server error" } } } },
    "/accounts": { "post": { "summary": "Link an OAuth Account", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } }, "responses": { "200": { "description": "Account linked" }, "500": { "description": "Server error" } } } },
    "/accounts/{provider}/{providerAccountId}": {
      "get": { "summary": "Get Account by Provider", "parameters": [{ "name": "provider", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "providerAccountId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "A single OAuth account" }, "500": { "description": "Server error" } } },
      "put": { "summary": "Update OAuth Account Tokens", "parameters": [{ "name": "provider", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "providerAccountId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "access_token": { "type": "string" }, "refresh_token": { "type": "string" } } } } } }, "responses": { "200": { "description": "Tokens updated" }, "500": { "description": "Server error" } } },
      "delete": { "summary": "Unlink OAuth Account", "parameters": [{ "name": "provider", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "providerAccountId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Account unlinked" }, "500": { "description": "Server error" } } }
    },
    "/friends": { "post": { "summary": "Add a Friend", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Friend" } } } }, "responses": { "200": { "description": "Friend added" }, "500": { "description": "Server error" } } } },
    "/friend-requests": {
      "post": {
        "summary": "Send a Friend Request",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["sender_email", "receiver_email"], "properties": { "sender_email": { "type": "string", "format": "email" }, "receiver_email": { "type": "string", "format": "email" }, "status": { "type": "string", "example": "pending" } } } } } },
        "responses": { "200": { "description": "Request sent" }, "404": { "description": "User not found" }, "500": { "description": "Server error" } }
      }
    },
    "/friend-requests/{id}": { "put": { "summary": "Update Friend Request Status", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] } } } } } }, "responses": { "200": { "description": "Updated" }, "500": { "description": "Server error" } } } },
    "/class-engagement": {
      "post": {
        "summary": "Record Class Engagement",
        "description": "Records or increments question count for a user in a specific class. Include color and light for pie chart styling.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClassEngagement" } } } },
        "responses": { "200": { "description": "Engagement recorded successfully" }, "500": { "description": "Server error" } }
      }
    },
    "/quizzes/{id}/questions": { "get": { "summary": "Get Quiz Questions", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Quiz with questions" }, "404": { "description": "Quiz not found" }, "500": { "description": "Server error" } } } },
    "/quizzes": { "post": { "summary": "Create a Quiz Attempt", "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/Quiz" }, { "type": "object", "properties": { "questions": { "type": "array", "items": { "$ref": "#/components/schemas/QuizQuestion" } } } }] } } } }, "responses": { "200": { "description": "Quiz created" }, "500": { "description": "Server error" } } } }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "user_123" },
          "email": { "type": "string", "format": "email" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "school": { "type": "string" },
          "major": { "type": "string" },
          "class_status": { "type": "string", "enum": ["Freshman", "Sophomore", "Junior", "Senior"] },
          "streak": { "type": "integer" },
          "total_xp": { "type": "integer" },
          "weekly_xp": { "type": "integer" },
          "image": { "type": "string" }
        }
      },
      "UserWithCounts": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "user_123" },
          "email": { "type": "string", "format": "email" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "school": { "type": "string" },
          "major": { "type": "string" },
          "class_status": { "type": "string", "enum": ["Freshman", "Sophomore", "Junior", "Senior"] },
          "streak": { "type": "integer", "example": 7 },
          "total_xp": { "type": "integer", "example": 500 },
          "weekly_xp": { "type": "integer", "example": 120 },
          "image": { "type": "string" },
          "friend_count": { "type": "integer", "example": 6 },
          "achievement_count": { "type": "integer", "example": 4 }
        }
      },
      "Class": {
        "type": "object",
        "properties": {
          "class_code": { "type": "string", "example": "CS101" },
